# ==============================================================================
# git/config.work — work identity
# ==============================================================================
#
# WHAT: The Git identity for every repository under ~/work/. The
#       [includeIf "gitdir:~/work/"] block in `config` loads it after the
#       personal [user] block, so these values win there.
# WHY : A separate file can be made local-only (see NOTE) without editing
#       `config`, and the [includeIf] block in `config` documents the
#       mechanism and the verification command.
# HOW : To apply the identity to another directory, add a second [includeIf]
#       in `config` pointing here or at a third file.
# NOTE: This file is committed, so the work email and public key fingerprint
#       are in the repository. To make it local-only: `git rm --cached
#       git/.config/git/config.work`, add it to .gitignore, and keep the
#       working copy in place; Git skips a missing include.
# ==============================================================================

[user]
    email = crcristea@bitdefender.com
    signingKey = 1E88F09E52DD18FF0BF57AF06719A214B5E50D7F
    # name is inherited from the personal identity in `config`.
