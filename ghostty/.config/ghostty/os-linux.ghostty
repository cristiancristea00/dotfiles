# ==============================================================================
# os-linux.ghostty — Ghostty settings that apply on Linux
# ==============================================================================
#
# Included by the `config-file = ?os.ghostty` line at the bottom of
# `config.ghostty`, through a symlink install.sh points here on Linux. The
# include is last, so values here override the base config. Same format rules
# as `config.ghostty`: no trailing comments.
#
# Two kinds of key live here. Most are the Linux counterpart of a macOS-only
# key: where Ghostty gives Linux an equivalent, it is set here with the same
# intent; where it gives none, the "No Linux counterpart" note at the bottom
# says so, rather than leaving the reader to compare the two files. The rest
# apply on both platforms and differ only in value, which is why they are not
# in config.ghostty; font-size and command are the two such keys today.
# ==============================================================================

# --- Shell --------------------------------------------------------------------
# WHAT: The program Ghostty launches, as an absolute path.
# WHY : The Homebrew prefix on Linux. config.ghostty explains why a bare name
#       cannot serve and why the key lives in the per-OS files; this is the
#       Linux half of that pair, and os-darwin.ghostty the other. It matters
#       more here than there: ../../../install.sh gates set_login_shell on
#       having a terminal, so an unattended install leaves the passwd entry at
#       the distribution's default shell, and without this key Ghostty would
#       start that shell.
# NOTE: This decides what Ghostty starts, not what $SHELL says. On macOS
#       login(1) sets SHELL from the passwd entry; on Linux there is no such
#       wrapper and Ghostty sets nothing, so the child inherits the desktop
#       session's SHELL. Until `chsh` has run, fish therefore runs with
#       $SHELL still naming the old shell, and anything that spawns $SHELL —
#       Neovim's `:terminal`, `sudo -s`, tmux — gets that one. Running
#       `./install.sh` from a terminal, or `chsh` by hand, is the fix.
#       Unlike macOS, Ghostty does not start a login shell here: it wraps the
#       value in `/bin/sh -c` with no `-l`. Nothing is lost by it. The fish
#       config is sourced whether or not the shell is a login shell, and
#       path_helper, which the login case exists for, is macOS-only.
# HOW : A distribution-packaged fish lives at /usr/bin/fish; change the path
#       here. Do not add a `direct:` prefix, which would split the value on
#       single spaces and support no quoting.
# default: (unset: $SHELL in a CLI environment, then the passwd entry)
command = /home/linuxbrew/.linuxbrew/bin/fish

# --- Rendering ----------------------------------------------------------------
# WHAT: Point size. Fractional values are allowed (e.g. 14.5).
# WHY : 11 here against 14 in os-darwin.ghostty. The two are matched by
#       apparent size rather than by number: macOS scales the whole UI by the
#       display's backing factor, and this desktop runs unscaled, so the point
#       size absorbs the difference. Zed and VS Code keep 14 on both platforms;
#       ../../../README.md § The font stack has the table.
# HOW : Set it in both per-OS files, or the two platforms drift.
# default: 13
font-size = 11

# WHAT: Which named faces of the font family to use, for the regular weight,
#       the italic, the bold, and the bold italic. Each name must match the
#       style the font itself advertises.
# WHY : The counterpart of `font-thicken = true` in os-darwin.ghostty.
#       Thickening is a CoreText feature and does nothing under FreeType, so
#       Linux gets the weight from the font instead. SemiBold is two steps
#       above Regular, which reads at the smaller Linux size the way the
#       thickened macOS text reads at 14.
#       Bold moves with it. SemiBold body text against the family's Bold is one
#       weight step, too little for bold to register, so bold goes to ExtraBold
#       and keeps a two-step gap. All four faces are named rather than two,
#       because Ghostty derives none of them from the others.
# NOTE: A style name that does not match fails silently — Ghostty falls back to
#       Regular, `+validate-config` still exits 0, and `+show-face` reports the
#       family rather than the face, so there is no command that confirms this
#       took effect. Check it by eye.
#       The fallback families advertise their own spellings, and neither name
#       here matches: `FiraCode Nerd Font Mono` offers Reg, Light, Ret, Med,
#       SemBd, and Bold, so it abbreviates SemiBold to `SemBd` and has no
#       ExtraBold at all. Only the primary family is restyled, which is where
#       all but a few glyphs come from, so a glyph served by a fallback renders
#       at that family's own weight.
# HOW : List what a family advertises with:
#           ghostty +list-fonts --family="JetBrainsMono Nerd Font Mono"
#       JetBrainsMono NFM offers Thin, ExtraLight, Light, Regular, Medium,
#       SemiBold, Bold, and ExtraBold, each with an italic. Drop both pairs one
#       step, to Medium and Bold, for a lighter result.
# default: default
font-style = SemiBold
# default: default
font-style-italic = SemiBold Italic
# default: default
font-style-bold = ExtraBold
# default: default
font-style-bold-italic = ExtraBold Italic

# --- Window -------------------------------------------------------------------
# WHAT: The GTK titlebar style. `tabs` merges the tab bar into the titlebar.
# WHY : The counterpart of `macos-titlebar-style = tabs` in os-darwin.ghostty,
#       with the same two values and the same effect: it reclaims the row a
#       separate tab bar takes below the titlebar.
# NOTE: With `tabs` the titlebar cannot be dragged by a tab title, only by the
#       area beside the tabs. The style has no effect when `window-decoration`
#       is `none`.
# HOW : Values: native, tabs.
# default: native
gtk-titlebar-style = tabs

# --- Keybinds -----------------------------------------------------------------
# The macOS file binds these actions to `super` (⌘). On Linux `super` is the
# Windows key, which desktop environments reserve (GNOME opens the Activities
# Overview on it, KDE the application launcher), so those bindings would
# register and never fire. Ctrl+Shift is the convention Linux terminals and
# Ghostty's own Linux defaults use. Plain Ctrl+key is reserved for control
# characters: Ctrl+C is SIGINT, Ctrl+D is EOF.
#
# Splits: new split to the right, new split below, zoom the focused split
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+enter=toggle_split_zoom
#
# Split navigation: Ctrl+Alt + arrow moves focus in that direction
keybind = ctrl+alt+arrow_left=goto_split:left
keybind = ctrl+alt+arrow_right=goto_split:right
keybind = ctrl+alt+arrow_up=goto_split:up
keybind = ctrl+alt+arrow_down=goto_split:down
#
# Tabs and surfaces: new tab, close the focused surface
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
#
# Config: reload this configuration
keybind = ctrl+shift+comma=reload_config
#
# Quick terminal: Ctrl+` drops it in from the centre (quick-terminal-position
# in `config`). Ghostty binds nothing to this action by default, so without
# this line the quick terminal is unreachable. Ctrl+` rather than Ctrl+Shift+`
# because this is a single toggle, not one of the window-management actions
# above, and ` carries no control character to shadow.
#
# `global:` needs a desktop that implements the XDG GlobalShortcuts portal,
# where macOS needs accessibility permission instead. KDE Plasma 5.27 and
# later and GNOME 48 and later work with no configuration; Hyprland needs
# xdg-desktop-portal-hyprland plus manual D-Bus shortcut setup; wlroots-based
# compositors such as Sway have not implemented the portal, so there the
# binding fires only while Ghostty has focus. Available since Ghostty 1.2.0 on
# GTK.
#
# `backquote` is the W3C physical key code for the ` key, which is what
# `ghostty +list-keybinds` prints and what matches the key regardless of
# keyboard layout. `grave_accent` is accepted too and resolves to the same
# binding.
keybind = global:ctrl+backquote=toggle_quick_terminal

# --- No Linux counterpart -----------------------------------------------------
# Four keys in os-darwin.ghostty have no Linux equivalent in Ghostty. They are
# listed so the two files can be read as a pair without checking each key.
#
# macos-option-as-alt      Alt is already Meta on Linux; nothing to remap.
# macos-applescript        AppleScript is macOS-only. Ghostty's GTK build
#                          exposes no scripting interface to disable.
# macos-shortcuts          The Shortcuts app is macOS-only.
# macos-dock-drop-behavior There is no Dock. `gtk-single-instance` governs
#                          whether a launch reuses the running process, which
#                          is a different question, and is left at `detect`.

# --- Documented extension points (inactive) -----------------------------------
# WHAT: Window decoration mode, the Linux counterpart to macos-titlebar-style.
#       `auto` lets the compositor decide; `none` removes the titlebar for a
#       tiling window manager.
# default: auto
# window-decoration = auto
#
# WHAT: Whether GTK draws the titlebar, and where it puts the tab bar.
# NOTE: With `gtk-titlebar-style = tabs` above, the tab bar is in the titlebar
#       and gtk-tabs-location no longer applies.
# default: true
# gtk-titlebar = true
# default: top
# gtk-tabs-location = top
#
# WHAT: Whether the quick terminal closes when it loses focus.
# WHY : The default differs by platform: true on macOS, false on Linux, because
#       a global shortcut needs desktop configuration here and is therefore
#       less convenient to press again. Set true to match macOS.
# default: false
# quick-terminal-autohide = false
#
# WHAT: Which compositor layer the quick terminal sits in, and when it takes
#       keyboard input. Both are Wayland-only.
# default: top
# gtk-quick-terminal-layer = top
# default: on-demand
# quick-terminal-keyboard-interactivity = on-demand
