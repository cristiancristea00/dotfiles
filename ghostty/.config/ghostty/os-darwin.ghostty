# ==============================================================================
# os-darwin.ghostty — Ghostty settings that apply on macOS
# ==============================================================================
#
# Included by the `config-file = ?os.ghostty` line at the bottom of
# `config.ghostty`, through a symlink install.sh points here on macOS. The
# include is last, so values here override the base config. Same format rules
# as `config.ghostty`: no trailing comments.
#
# Two kinds of key live here. Most apply only to macOS: Ghostty compiles every
# platform's keys on all platforms, so those would parse on Linux too and do
# nothing, and they sit here so the config states where they apply. The rest
# apply on both platforms and differ only in value, which is why they are not
# in config.ghostty; font-size is the one such key today.
#
# os-linux.ghostty carries the counterpart of each key that has one, and names
# the ones that do not.
# ==============================================================================

# --- Keyboard -----------------------------------------------------------------
# WHAT: Treat the left Option key as Alt/Meta; the right one keeps composing
#       macOS special characters (é, ß, …).
# WHY : Neovim's <M-j> / <M-k> line-moving keymaps need Option as Meta in the
#       terminal. Unset, Ghostty treats Option as Meta only on U.S. keyboard
#       layouts; `left` makes it explicit and keeps the right key composing.
#       Matches vim.g.neovide_input_macos_option_key_is_meta = "only_left" in
#       ../../../nvim/.config/nvim/lua/core/neovide.lua. Linux needs no
#       equivalent; Alt is Meta there.
# HOW : Values: true, false, left, right.
# default: (unset: true on U.S. layouts, false otherwise)
macos-option-as-alt = left

# --- Shell --------------------------------------------------------------------
# WHAT: The program Ghostty launches, as an absolute path.
# WHY : The Homebrew prefix on Apple Silicon. config.ghostty explains why a
#       bare name cannot serve and why the key lives in the per-OS files; this
#       is the macOS half of that pair, and os-linux.ghostty the other.
# NOTE: This is the value Ghostty would reach on its own from the passwd entry
#       on a machine where `chsh` has run, so on a Dock launch it changes
#       nothing. What it adds is that `ghostty` typed in a shell whose $SHELL
#       is zsh starts fish rather than zsh, because $SHELL only wins when
#       Ghostty judges the launch to be a CLI one.
#       Setting it does not move where new windows open. Ghostty still reads
#       the passwd entry for the home directory whenever `working-directory`
#       resolves to `home`, which is what a desktop launch gets.
# HOW : An Intel Mac keeps fish under /usr/local/bin; change the path here.
#       Do not add a `direct:` prefix, which would cost the login shell.
# default: (unset: $SHELL in a CLI environment, then the passwd entry)
command = /opt/homebrew/bin/fish

# --- Rendering ----------------------------------------------------------------
# WHAT: Point size. Fractional values are allowed (e.g. 14.5).
# WHY : 14 here against 11 in os-linux.ghostty. The two are matched by apparent
#       size rather than by number: macOS scales the whole UI by the
#       display's backing factor, and this desktop runs unscaled, so the point
#       size absorbs the difference. Zed and VS Code keep 14 on both platforms;
#       ../../../README.md § The font stack has the table.
# HOW : Set it in both per-OS files, or the two platforms drift.
# default: 13
font-size = 14

# WHAT: Render glyphs with a slightly thicker stroke. macOS-only.
# WHY : Compensates for macOS's thin subpixel rendering on non-Retina and
#       scaled displays. The Linux counterpart is `font-style = SemiBold` in
#       os-linux.ghostty, which picks heavier faces instead, because thickening
#       is a CoreText feature FreeType has no equivalent for.
# NOTE: `font-thicken-strength` sets how much, 0 to 255, and is left at 255,
#       the heaviest. It has no effect while `font-thicken` is false.
# default: false
font-thicken = true

# WHAT: Use the native macOS glass effect behind the window instead of a plain
#       blur.
# WHY : Overrides `background-blur = true` in `config`, which is blur intensity
#       20 and the most any Linux desktop honours. `macos-glass-regular` is the
#       system material, so the window matches other macOS 26 chrome rather
#       than approximating it.
# NOTE: Needs macOS 26.0 or later; on an older release the value falls back to
#       a plain blur. `macos-glass-clear` is the more transparent variant.
# default: false
background-blur = macos-glass-regular

# --- Window -------------------------------------------------------------------
# WHAT: The titlebar style. `tabs` merges the tab bar into the titlebar.
# WHY : Reclaims the row a separate tab bar takes, and the titlebar then always
#       matches the terminal background. This is the one place Ghostty's chrome
#       diverges from `frame = "transparent"` in
#       ../../../neovide/.config/neovide/config.toml: Neovide has no tabs to
#       merge, so it has nothing to gain from the style. os-linux.ghostty sets
#       `gtk-titlebar-style = tabs`, the same choice under GTK.
# NOTE: With `tabs` the titlebar cannot be dragged by a tab title, only by the
#       empty area beside the tabs. It also makes `window-theme` inert for
#       terminal windows, because the titlebar takes its appearance from the
#       background colour's luminosity instead.
# HOW : Values: native, transparent, tabs, hidden. Applies to new windows only.
# default: transparent
macos-titlebar-style = tabs

# WHAT: What happens when a file or folder is dropped on the Dock icon.
# WHY : A new window, so the dropped directory does not appear as a tab beside
#       unrelated work in whichever window happened to be frontmost.
# HOW : Values: new-tab, new-window.
# default: new-tab
macos-dock-drop-behavior = new-window

# --- Automation ---------------------------------------------------------------
# WHAT: Whether Ghostty exposes its AppleScript dictionary, and whether the
#       Shortcuts app may drive it.
# WHY : Both off. Between them they let any script create terminals, send text
#       to them, run commands, and invoke any keybind action, which is a large
#       surface for something this setup never scripts. `deny` is stronger than
#       the `ask` default, which remembers one answer and never asks again.
# NOTE: What this costs: `osascript -e 'tell application "Ghostty" …'` stops
#       working, and so does any Alfred or Raycast action built on it. What it
#       does not cost: VS Code's "Open in External Terminal" launches Ghostty
#       through `/usr/bin/open` with `--working-directory` and `-e`, not
#       AppleScript, so `terminal.external.osxExec` in
#       ../../../vscode/.config/Code/User/settings.json keeps working.
# HOW : macos-shortcuts takes ask, allow, or deny. Available since Ghostty
#       1.2.0.
# default: true
macos-applescript = false
# default: ask
macos-shortcuts = deny

# --- Keybinds -----------------------------------------------------------------
# These restate Ghostty's macOS defaults, so the bindings stay as documented
# here if upstream defaults change. `super` is ⌘. os-linux.ghostty binds the
# same actions to Ctrl+Shift and explains why.
#
# Splits: new split to the right, new split below, zoom the focused split
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+shift+enter=toggle_split_zoom
#
# Split navigation: ⌘⌥ + arrow moves focus in that direction
keybind = super+alt+arrow_left=goto_split:left
keybind = super+alt+arrow_right=goto_split:right
keybind = super+alt+arrow_up=goto_split:up
keybind = super+alt+arrow_down=goto_split:down
#
# Tabs and surfaces: new tab, close the focused surface
keybind = super+t=new_tab
keybind = super+w=close_surface
#
# Config: reload this configuration
keybind = super+shift+comma=reload_config
#
# Quick terminal: ⌘` drops it in from the centre (quick-terminal-position in
# `config`). Ghostty binds nothing to this action by default, so without this
# line the quick terminal is unreachable. `global:` makes the binding fire
# while another application has focus, which is the whole point of a quick
# terminal, and it implies `all:`.
#
# `global:` on macOS needs accessibility permission. Ghostty asks for it the
# first time a global keybind is loaded or reloaded; until it is granted in
# System Settings > Privacy & Security > Accessibility, this binding does
# nothing while another application has focus. It still works when Ghostty is
# focused. os-linux.ghostty needs the equivalent portal instead.
#
# `backquote` is the W3C physical key code for the ` key, which is what
# `ghostty +list-keybinds` prints and what matches the key regardless of
# keyboard layout. `grave_accent` is accepted too and resolves to the same
# binding.
keybind = global:super+backquote=toggle_quick_terminal
