# ==============================================================================
# git/ignore — global gitignore
# ==============================================================================
#
# WHAT: Patterns Git ignores in every repository on this machine, in addition
#       to each repository's own .gitignore.
# WHY : ~/.config/git/ignore is Git's XDG location for this file, read without
#       a core.excludesFile setting.
# HOW : Keep the list to files every machine or OS produces. Build artefacts
#       belong in the project's .gitignore, which other contributors share.
# ==============================================================================

# macOS Finder metadata, created in any directory Finder opens.
.DS_Store

# Editor backup files (Vim, Emacs, and others).
*~

# Claude Code's per-machine settings: machine-specific permissions that must
# not be shared, in a directory that is often committed.
**/.claude/settings.local.json
