# Files stow must NOT symlink out of this package.
#
# IMPORTANT: this file REPLACES stow's built-in ignore list rather than adding
# to it, so every default worth keeping has to be restated here. The entries
# are anchored regexes; a leading ^/ anchors to the top of the package.

# --- stow's defaults, restated -------------------------------------------------
^/README.*
^/LICENSE.*
^/COPYING
\.git
\.gitignore
\.gitmodules
.+~
\#.*\#

# --- this package's additions ---------------------------------------------------
# The extension lists are inputs to install.sh, not files that belong in $HOME.
^/extensions.*\.txt
# macOS drops these into any directory Finder visits.
\.DS_Store
