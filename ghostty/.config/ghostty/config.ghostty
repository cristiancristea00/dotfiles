# ==============================================================================
# ghostty/config.ghostty — Ghostty terminal emulator
# ==============================================================================
#
# WHAT THIS FILE IS
#   Ghostty's configuration, read from ~/.config/ghostty/config.ghostty at
#   startup. One `key = value` per line; `#` starts a comment. Some keys are
#   repeatable: listing them more than once appends rather than overwrites,
#   which is how font fallbacks and keybinds work.
#
#   FORMAT TRAP: there are no trailing comments. Everything after `=` to the
#   end of the line is the value, so `font-thicken = true  # default: false`
#   sets the value to "true  # default: false" and the key is rejected. Every
#   annotation below sits on its own line.
#
#   FORMAT TRAP: Ghostty 1.3.1 stops reading a config file at a comment or
#   blank line that ends exactly on a 2048-byte boundary, and applies nothing
#   below it. A setting on the boundary is unaffected. No error is reported,
#   `+validate-config` still exits 0, and every setting past the boundary
#   silently keeps its default. Editing a comment above a setting is enough to
#   move a file onto or off the boundary, so check after any edit — the
#   command is in ../../../README.md § Verifying a change. Upstream commit
#   c247e455c fixes it; the check goes when a release carrying it ships.
#
#   FORMAT TRAP: `config.ghostty` is the name Ghostty 1.3.0 moved to, and the
#   pre-1.3.0 `~/.config/ghostty/config` is still read when it exists. Both
#   are loaded, the old name first, and Ghostty logs "both config files …
#   exist". A scalar set in both takes the value from this file, but the
#   repeatable keys here — font-family, font-feature, keybind, and palette —
#   append twice instead. Leave only one of the two in place.
#
# RELOADING
#   ⌘⇧, (macOS) or Ctrl+Shift+, (Linux) reloads this file in place. A few keys,
#   `command` and the window size among them, apply only to new windows.
#
# VALIDATING
#   Ghostty ignores keys it does not recognise, so a typo fails silently.
#       ghostty +validate-config          checks syntax only
#       ghostty +show-config              prints the resolved values, which is
#                                         how to confirm the per-OS include loaded
#       ghostty +show-config --default    lists every key and its default
#
# PLATFORM-SPECIFIC SETTINGS
#   Two kinds of key live in the per-OS files: ones only one platform has, and
#   ones both platforms have at different values. The macOS-only keys and the
#   ⌘ keybinds are in os-darwin.ghostty, the Linux ones and the Ctrl+Shift
#   keybinds in os-linux.ghostty, and font-size is in both, at a different
#   value in each. The `config-file` line at the end of this file includes
#   whichever one install.sh has linked as os.ghostty.
#
# FONTS
#   Terminals get the Nerd Font build, editors the plain one; ligatures are on
#   everywhere. See ../../../README.md § The font stack.
# ==============================================================================

# --- Font ---------------------------------------------------------------------
# WHAT: The font stack. `font-family` is repeatable: the first entry is the
#       primary font and each later one is a fallback for codepoints the
#       previous ones lack.
# WHY : The Nerd Font Mono build supplies the icons Neovim draws here, at one
#       cell each, so the grid stays aligned; the plain Nerd Font build draws
#       icons at double width. With no font-family set, Ghostty uses its
#       bundled font and every Nerd Font icon renders as a blank box. The two
#       Nerd builds lead the chain so a glyph missing from the first is served
#       by a font that still has icons; plain JetBrains Mono follows as the
#       same typeface without icons, and as the fallback when no Nerd build is
#       installed.
# HOW : Check that a family name resolves:
#           ghostty +list-fonts | grep -i "jetbrains"
font-family = JetBrainsMono Nerd Font Mono
font-family = FiraCode Nerd Font Mono
font-family = JetBrains Mono
font-family = Fira Code
font-family = Source Code Pro
font-family = IBM Plex Mono

# WHAT: OpenType features. Repeatable; `+tag` enables, `-tag` disables.
# WHY : Ligatures on, matching every other surface in the repo. The `calt`
#       feature (contextual alternates) fuses `!=`, `->`, and `===` in
#       JetBrains Mono and Fira Code; `liga` is the standard ligature set.
#       Both are named rather than left to the font's defaults, so the same two
#       features appear here, in the editors, and in Neovide.
# NOTE: Ghostty applies these to every family in the chain, so Fira Code gets
#       its ligatures without an entry of its own; Neovide needs one per
#       family.
# HOW : Set `-calt` and `-liga` to turn them off for command output.
font-feature = +calt
font-feature = +liga

# --- Theme --------------------------------------------------------------------
# WHAT: Colour scheme. The `light:NAME,dark:NAME` form selects by system
#       appearance and switches when the system does.
# WHY : Catppuccin Latte and Mocha, the pair every tool in the stack uses; see
#       ../../../README.md § Light and dark. Ghostty bundles all four
#       Catppuccin flavours, so nothing is installed.
# HOW : `ghostty +list-themes` shows every bundled theme. The other dark
#       flavours are `Catppuccin Frappe` (Ghostty spells it without the accent)
#       and `Catppuccin Macchiato`.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# WHAT: Derive palette indices 16-255 from the base 16 ANSI colours, and
#       reverse the generated ramp so it reads on a light background too.
# WHY : The bundled Catppuccin themes set indices 0-15 only, so 16-255 are
#       still xterm's and a 256-colour program draws colours from outside the
#       flavour. Generating them keeps every colour a program can pick inside
#       the palette. `palette-harmonious` reverses the ramp's direction, which
#       is what lets one generated palette serve Latte and Mocha; it has no
#       effect unless `palette-generate` is on.
# NOTE: The defaults are off because a program that hardcodes the xterm 256
#       cube — assuming indices 16-231 run darkest to lightest — renders wrong.
#       Both keys arrived in Ghostty 1.3.0.
# HOW : Compare with `ghostty +list-colors`. An index set explicitly with
#       `palette` is never overwritten by the generator.
# default: false
palette-generate = true
# default: false
palette-harmonious = true

# --- Window -------------------------------------------------------------------
# WHAT: Initial size, in cells (not pixels).
# WHY : The default, 0, lets Ghostty pick a size. 100×30 sets it for new
#       windows; the window manager may still override it.
# default: 0
window-width = 100
window-height = 30

# WHAT: Padding between the text grid and the window edge, in points.
# WHY : The 2pt default puts text almost against the frame.
# default: 2
window-padding-x = 10
# default: 2
window-padding-y = 8

# WHAT: Window translucency (0 = invisible, 1 = opaque) and a blur behind it,
#       so the background stays blurred behind the text.
# WHY : The same pair of values Neovide uses (the Transparency block in
#       ../../../nvim/.config/nvim/lua/core/neovide.lua), so the terminal and
#       the editor sit at the same depth on the desktop. Change both together
#       or they diverge. `true` is blur intensity 20; os-darwin.ghostty raises
#       it to the native macOS glass effect, which needs a value this file
#       cannot use on Linux.
# NOTE: The blur is supported on macOS and KDE Plasma. Other Linux desktops
#       are unsupported, so under GNOME's Mutter it has no effect, and KWin
#       ignores the intensity because Plasma has one global blur setting.
# default: 1
background-opacity = 0.95
# default: false
background-blur = true

# WHAT: How opaque an unfocused split is, so the focused one stands out.
# WHY : Ghostty fades unfocused splits by default, but at 0.7 against
#       `background-opacity = 0.95` the difference is barely perceptible. 0.5
#       makes which split has focus readable at a glance. Set 1 for no fade.
# NOTE: Values below 0.15 are clamped to 0.15.
# default: 0.7
unfocused-split-opacity = 0.5

# --- Cursor and mouse ---------------------------------------------------------
# WHAT: Cursor shape.
# WHY : A block, like every other tool here; see ../../../README.md § The
#       cursor. Pairs with `no-cursor` in shell-integration-features below,
#       which stops shell integration changing the shape per mode.
#       Applications still set the shape through DECSCUSR, which is how Neovim
#       gets its block.
# default: block
cursor-style = block

# WHAT: Whether the cursor blinks.
# WHY : Blinking, like Zed and VS Code (see ../../../README.md § The cursor).
# NOTE: `true` differs from leaving this unset, though both blink. Unset,
#       Ghostty also honours DEC Mode 12, so a program can turn blinking off;
#       any explicit value makes Ghostty ignore Mode 12. DECSCUSR is honoured
#       either way, so the shape stays application-controlled.
# default: (unset: blinks, but Mode 12 can disable it)
cursor-style-blink = true

# WHAT: Hide the mouse pointer while typing; it reappears on movement.
# WHY : Matches vim.g.neovide_hide_mouse_when_typing in
#       ../../../nvim/.config/nvim/lua/core/neovide.lua.
# default: false
mouse-hide-while-typing = true

# WHAT: Copy a selection as soon as it is made. `clipboard` writes both the
#       selection clipboard and the system clipboard; `true` prefers the
#       selection clipboard alone.
# WHY : On Linux the two clipboards are separate, so `true` would put a
#       selection where middle-click pastes it but Ctrl+Shift+V does not.
#       Writing both makes every paste route see the same text.
# NOTE: macOS has no selection clipboard, so there `clipboard` and `true` both
#       mean the system clipboard, and every selection overwrites what ⌘C put
#       there. Middle-click paste reads the selection clipboard whatever this
#       is set to, including `false`.
# default: true
copy-on-select = clipboard

# --- Shell --------------------------------------------------------------------
# WHAT: The program Ghostty launches. It is set, but not here: the per-OS
#       files carry it, because the value is an absolute path and the path
#       differs by platform.
# WHY : A bare name cannot serve. It is resolved against the PATH Ghostty
#       itself inherited, and on macOS that resolution happens inside
#           /usr/bin/login -flp <user> /bin/bash --noprofile --norc
#               -c "exec -l <command>"
#       where --noprofile keeps /etc/profile out of the run, so path_helper
#       never adds /etc/paths.d and the PATH stays whatever the process was
#       given. A launch from the Dock or Spotlight inherits launchd's
#       /usr/bin:/bin:/usr/sbin:/sbin, which holds no Homebrew prefix, so a
#       name such as `fish` is not found and the surface dies with "Ghostty
#       failed to launch the requested command".
#       Leaving it unset very nearly works, since both fallbacks are absolute
#       and the passwd entry is what `chsh` sets. What it does not survive is a
#       launch from a shell whose $SHELL is another shell, which Ghostty then
#       prefers, and a Linux install where set_login_shell was skipped for want
#       of a terminal, leaving the passwd entry at the distribution default.
# NOTE: Four prefixes hold fish — /opt/homebrew on Apple Silicon, /usr/local on
#       Intel, /home/linuxbrew/.linuxbrew, and a distribution's /usr/bin — and
#       the two per-OS files cover one each. Apple Silicon and Homebrew on
#       Linux are set; an Intel Mac or a distribution-packaged fish needs the
#       path edited in the matching file, which is a one-line change.
#       The `direct:` prefix must not be used for it. It skips the bash
#       wrapper above, and with it the `exec -l` that puts the leading hyphen
#       on argv[0], so fish stops being a login shell and no longer runs
#       path_helper. An unprefixed value is the `shell:` form and keeps it.
# NOTE: The $SHELL variable wins over the passwd entry, but only when Ghostty
#       judges it was started from a command line, which its
#       probableCliEnvironment() decides. A launch from the Dock, Spotlight, or
#       Finder is not one, and there $SHELL is skipped rather than preferred,
#       because a desktop session holds the value its shell had at login. Such
#       a launch therefore reads the passwd entry, and `chsh` reaches the next
#       window rather than the next login. Typing `ghostty` at a prompt is a
#       CLI launch and does take $SHELL. Setting `command` removes that
#       difference: one value serves every launch route.
# HOW : The value applies to new surfaces only, so a reload leaves running
#       shells alone. Confirm what resolved with:
#           ghostty +show-config | grep '^command'
# default: (unset: $SHELL in a CLI environment, then the passwd entry)

# WHAT: How Ghostty integrates with the shell it started. Naming a shell forces
#       that scheme; `detect` picks one from the shell binary's filename.
# WHY : Named rather than detected, to state which shell this config runs and
#       to keep the two settings from having to agree. Detection matches the
#       basename of `command`, so it resolves fish today either way; it would
#       stop the day `command` pointed at a wrapper script under another name,
#       and it fails silently when it does. Integration is what supplies
#       working-directory inheritance for new tabs, prompt marking, the
#       no-confirmation close at a prompt, and the OSC 133 marks
#       notify-on-command-finish below needs.
# NOTE: For fish the injection is environmental, not an argument: Ghostty
#       prepends its own directory to XDG_DATA_DIRS, and fish sources the
#       vendor_conf.d it finds there. So it works with an absolute `command`
#       and needs no shell flags. Anything that overwrites XDG_DATA_DIRS after
#       Ghostty sets it loses the integration.
# HOW : Values: none, detect, bash, elvish, fish, nushell, or zsh. Ghostty logs
#       which one it injected; run it from a terminal to see the line.
# default: detect
shell-integration = fish

# WHAT: Integration features to toggle; a `no-` prefix disables one. Features
#       not listed keep their defaults, so this names only the four that differ
#       from them.
# WHY : `no-cursor` stops the shell changing the cursor shape per mode (see
#       cursor-style above). `sudo` wraps sudo so it keeps the terminfo.
#       `ssh-env` rewrites TERM from xterm-ghostty to xterm-256color when
#       connecting to a remote host and forwards COLORTERM, TERM_PROGRAM, and
#       TERM_PROGRAM_VERSION, so a host without Ghostty's terminfo still
#       renders. `ssh-terminfo` instead installs that terminfo with `infocmp`
#       and `tic` on first connection and caches the result. With both on,
#       Ghostty installs the terminfo and uses xterm-ghostty, falling back to
#       xterm-256color when the install fails.
# NOTE: `title` and `path` are on by default and deliberately not listed, so
#       the line reads as the set of deviations. `title` lets the shell set the
#       window title to the running command; `path` adds Ghostty's own bin
#       directory to PATH, so `ghostty` stays callable when a shell init script
#       rewrites PATH.
# HOW : `ghostty +ssh-cache` lists and clears the remote terminfo cache. The
#       SSH features arrived in Ghostty 1.2.0.
# default: cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path
shell-integration-features = no-cursor,sudo,ssh-env,ssh-terminfo

# --- Bell and notifications ---------------------------------------------------
# WHAT: Which bell effects to enable; a `no-` prefix disables one, and effects
#       not listed keep their defaults.
# WHY : `system` hands the bell to the OS, which plays the macOS alert sound or
#       triggers the desktop's own bell on Linux, so a bell is audible without
#       this repo shipping a sound file. `border` draws a border round the
#       alerted surface, the only one of the four effects visible while the
#       window already has focus.
# NOTE: `attention` and `title` are on by default and not listed: `attention`
#       bounces the Dock icon once while Ghostty is unfocused, and `title`
#       prefixes the surface title with a bell emoji until the terminal is
#       touched again. `audio` stays off, its default, because it needs a sound
#       file named by `bell-audio-path`, which this config does not set.
# HOW : Which effect a Linux desktop produces for `system` depends on the
#       desktop: GNOME's "Sound > Alert Sound", KDE's "Accessibility > System
#       Bell". Available since Ghostty 1.2.0; `border` since 1.2.1 on macOS.
# default: no-system,no-audio,attention,title,no-border
bell-features = system,border

# WHAT: Notify when a long-running command finishes, and how.
# WHY : `unfocused` fires only when the surface running the command is not
#       focused, which is the case worth interrupting; `always` would notify
#       for every command typed in the foreground. The action adds `notify`, a
#       desktop notification, to the `bell` that is on by default, so a
#       finished build is visible as well as audible.
# NOTE: Both keys need shell integration, or a shell that emits the OSC 133
#       prompt marks itself. `shell-integration = detect` above provides it.
#       `notify-on-command-finish-after` sets how long a command must run
#       first; its default of 5s is kept, so short commands stay silent.
#       Available since Ghostty 1.3.0.
# default: never
notify-on-command-finish = unfocused
# default: bell,no-notify
notify-on-command-finish-action = notify,bell

# --- Quick terminal -----------------------------------------------------------
# WHAT: Where the drop-down quick terminal appears.
# WHY : Centred, so it is in the same place on every display size; `top` slides
#       it out of the menu bar on macOS, which overlaps the notch on some
#       displays.
# NOTE: Ghostty binds no key to `toggle_quick_terminal`, so this does nothing
#       on its own. The per-OS files bind it: ⌘` on macOS, Ctrl+` on Linux.
#       Changing this value needs a full restart on macOS, not a reload.
# HOW : `top`, `bottom`, `left`, `right`, or `center`. Linux adds
#       `gtk-quick-terminal-layer` and `quick-terminal-keyboard-interactivity`;
#       os-linux.ghostty documents both.
# default: top
quick-terminal-position = center

# --- Keybinds -----------------------------------------------------------------
# Keybinds live in the per-OS include. The Linux file explains why the
# modifier differs: ⌘ on macOS, Ctrl+Shift on Linux.
# See every default with: ghostty +list-keybinds --default

# --- Documented extension points (inactive) -----------------------------------
# WHAT: Whether a program in the terminal may read the system clipboard
#       through OSC 52. Writing is allowed unconditionally either way.
# WHY : Left at `ask`, which prompts once per surface. `allow` removes the
#       prompt, and with it the only signal that a program — including one on a
#       remote host reached over SSH — is reading what was last copied.
# default: ask
# clipboard-read = allow
#
# WHAT: Scrollback kept per surface, in bytes.
# NOTE: Bytes, not lines. The 10 MB default holds far more than the tens of
#       thousands of lines it looks like, and is allocated lazily.
# default: 10000000
# scrollback-limit = 10000000
#
# WHAT: Prompt before closing a surface that is still running something.
# default: true
# confirm-close-surface = true
#
# WHAT: Quit Ghostty when the last window closes. macOS apps normally stay
#       running with no windows.
# default: false
# quit-after-last-window-closed = true

# --- Platform include ---------------------------------------------------------
# WHAT: Include the OS-specific file. `?` makes the include optional, so
#       Ghostty starts before install.sh has created the symlink.
# WHY : Values in the included file win over everything in this one, so the
#       per-OS file can adjust anything above.
# NOTE: That is not a consequence of the line's position. Ghostty loads an
#       included file after the whole of the file that names it, wherever the
#       `config-file` line sits, so moving this line changes nothing and a key
#       added below it is still overridden by os.ghostty. The line stays last
#       because the reader expects the override to be the last word.
# HOW : install.sh points ~/.config/ghostty/os.ghostty at os-darwin.ghostty
#       or os-linux.ghostty. Confirm what resolved with
#       `ghostty +show-config`.
config-file = ?os.ghostty
