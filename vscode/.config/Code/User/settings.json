// ============================================================================
// settings.json — shared configuration for Visual Studio Code and Cursor
// ============================================================================
//
// WHAT THIS FILE IS
//   One file, four destinations. Cursor is a VS Code fork and accepts the VS
//   Code settings schema, so both editors read this file:
//       macOS   ~/Library/Application Support/{Code,Cursor}/User/settings.json
//       Linux   ~/.config/{Code,Cursor}/User/settings.json
//   The repo holds one real file, vscode/.config/Code/User/settings.json; the
//   other three paths are symlinks to it, which install.sh links into place.
//
// EDIT THIS FILE, NOT THE SETTINGS UI
//   Changing a value through the UI edits this JSONC file in place and keeps
//   the comments. Resetting a setting to its default deletes the setting's
//   line and every comment line directly above it (microsoft/vscode#275792,
//   open), which is the shape of this file.
//
//   Never add `window.zoomLevel`. The zoom shortcuts (⌘= / ⌘- on macOS,
//   Ctrl+= / Ctrl+- on Linux) write it without a visit to the Settings UI, so
//   a later reset fires that bug.
//   It also scales the editor and the chrome together, so it cannot make the
//   UI font larger than the code font (see UI FONT below).
//
//   If comments are lost, restore from git and re-link:
//       stow -R --no-folding --ignore='\.config' --target="$HOME" --dir="$PWD" vscode cursor  # from the repo root
//
// SETTINGS SYNC MUST STAY OFF
//   Settings Sync is a second writer to this file, driven by remote state, and
//   "Accept Remote" replaces the repo copy with the cloud copy. Its merge is
//   not documented to keep comments. This repo is the source of truth.
//
// EACH EDITOR IGNORES THE OTHER'S KEYS
//   `cursor.*` keys show an "Unknown Configuration Setting" warning in VS
//   Code's Problems panel, and the newest VS Code keys do the same in Cursor.
//   The key is kept and the rest of the file applies. Do not delete the keys.
//
// FONTS
//   The editor gets plain "JetBrains Mono"; the integrated terminal gets the
//   Nerd Font Mono build, because Neovim draws icons there. Ligatures are on
//   in both, through two separate keys. See ../../../../README.md § The font
//   stack.
//
//   Every setting VS Code accepts: https://code.visualstudio.com/docs/configure/settings
// ============================================================================
{
    // --- Editor font --------------------------------------------------------
    // WHAT: The editor font, as a CSS font stack.
    // WHY : The plain build, because the editor draws its own icons. VS Code
    //       has no separate fallback key; one comma-separated list does both.
    //       Multi-word names must be quoted, and the trailing `monospace`
    //       keyword is the CSS fallback if no named family resolves.
    // HOW : Keep this in step with the terminal stack below and with the other
    //       tools; ../../../../README.md § The font stack lists the files.
    "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Source Code Pro', 'IBM Plex Mono', monospace",

    // WHAT: Editor font size, in pixels.
    // WHY : 14 matches Ghostty, Neovim, Neovide, and Zed. The default is 12 on
    //       macOS and 14 on Linux.
    "editor.fontSize": 14,

    // WHAT: Programming ligatures, the fusing of `!=`, `->`, `=>`.
    // WHY : On in the editor. A bare `true` enables the font's default set; the
    //       string form is a raw CSS font-feature-settings value naming the
    //       same two features the rest of the repo names. Off by default.
    "editor.fontLigatures": "'calt', 'liga'",

    // WHAT: Line spacing. 0 computes it from the font size; values under 8 are
    //       a multiplier; 8 and above are absolute pixels.
    // WHY : 1.5 approximates Zed's "comfortable" line height. The default is 0.
    "editor.lineHeight": 1.5,

    // --- The other eight font keys ------------------------------------------
    // WHAT: The same family for every other surface VS Code renders text on.
    // WHY : Each of these keys defaults to something other than the editor
    //       font, so without them the CodeLens, inlay hints, inline
    //       suggestions, debug console, SCM input box, notebooks, and chat
    //       render in a different typeface from the code beside them. Zed has
    //       one buffer font and needs none of this.
    "editor.codeLensFontFamily": "'JetBrains Mono', monospace",
    "editor.inlayHints.fontFamily": "'JetBrains Mono', monospace",
    "editor.inlineSuggest.fontFamily": "'JetBrains Mono', monospace",
    "debug.console.fontFamily": "'JetBrains Mono', monospace",
    "scm.inputFontFamily": "'JetBrains Mono', monospace",
    "notebook.markup.fontFamily": "'JetBrains Mono', monospace",
    "notebook.output.fontFamily": "'JetBrains Mono', monospace",
    "chat.editor.fontFamily": "'JetBrains Mono', monospace",

    // --- UI font ------------------------------------------------------------
    // NOTE: VS Code has no UI-font-size setting, so Zed's `ui_font_size` has no
    //       equivalent here. `window.zoomLevel` scales the chrome and the
    //       editor together and triggers the comment-deleting bug described in
    //       the header, so it is not used.

    // --- Theme --------------------------------------------------------------
    // WHAT: Follow the OS appearance, choosing between the two named themes.
    // WHY : Catppuccin Latte and Mocha, the pair the stack uses; see
    //       ../../../../README.md § Light and dark. Auto-detection is off by
    //       default.
    // NOTE: `workbench.colorTheme`, the active theme, is not set here. With
    //       auto-detection on, VS Code rewrites that key every time the
    //       appearance flips, so committing it would produce a diff on every
    //       switch. The two `preferred*` keys are the settings.
    "window.autoDetectColorScheme": true,
    "workbench.preferredLightColorTheme": "Catppuccin Latte",
    "workbench.preferredDarkColorTheme": "Catppuccin Mocha",

    // WHAT: Catppuccin's own options. The theme is an extension, so unlike the
    //       built-in themes it contributes settings.
    // WHY : Mauve is the extension's default accent and italic comments its
    //       default too; upright, regular-weight keywords are the change here
    //       (the extension defaults to italic and bold). In Zed the accent can
    //       only be changed by adding theme files to Zed-managed state.
    // HOW : Accents: rosewater, flamingo, pink, mauve, red, maroon, peach,
    //       yellow, green, teal, sky, sapphire, blue, lavender.
    "catppuccin.accentColor": "mauve",
    "catppuccin.italicComments": true,
    "catppuccin.italicKeywords": false,
    "catppuccin.boldKeywords": false,

    // --- Indentation --------------------------------------------------------
    // WHAT: Four spaces, never hard tabs.
    // WHY : Matches Neovim's expandtab and shiftwidth = 4 and Zed's tab_size.
    //       Both are the defaults.
    "editor.tabSize": 4,
    "editor.insertSpaces": true,

    // WHAT: Whether to infer indentation from the file being opened.
    // WHY : Off; the default is on. When on, VS Code inspects the open file
    //       and overrides both settings above, so the four-space setting
    //       would hold only for files that already use it. Neither Zed nor
    //       Neovim does this.
    "editor.detectIndentation": false,

    // --- On save ------------------------------------------------------------
    // WHAT: Whitespace clean-ups applied on every save.
    // WHY : Both default to false. They touch whitespace only and never
    //       reformat code, so they are safe while formatting stays manual.
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,

    // WHAT: Run a formatter on every save.
    // WHY : Off (also the default), matching Neovim, where formatting is
    //       <leader>F through conform.nvim, and Zed. Saving a file in a shared
    //       codebase then does not reformat it.
    // HOW : Format on demand with Shift+Alt+F, or set this to true.
    "editor.formatOnSave": false,

    // WHAT: Save when the editor loses focus.
    // WHY : The default is "off". Matches Zed's autosave, so switching windows
    //       never leaves unsaved work.
    // NOTE: The value is camelCase; Zed's snake_case `on_focus_change` is not
    //       valid here.
    "files.autoSave": "onFocusChange",

    // --- Display ------------------------------------------------------------
    // WHAT: Highlight the line the cursor is on. "all" tints the gutter and the
    //       line background.
    // WHY : Matches Zed's `current_line_highlight: "all"`. The default,
    //       "line", tints the line only.
    "editor.renderLineHighlight": "all",

    // WHAT: Cursor shape and blinking.
    // WHY : A blinking block, like every tool here; see ../../../../README.md §
    //       The cursor. The default shape is "line".
    // NOTE: `cursorBlinking` is a string, not a boolean: "blink" is the
    //       default and "solid" is the off state.
    "editor.cursorStyle": "block",
    "editor.cursorBlinking": "blink",

    // WHAT: Absolute line numbers.
    // WHY : The default, stated because Neovim uses relative numbers for its
    //       motions; these editors are non-modal, so relative numbers would
    //       serve nothing. Zed makes the same choice.
    "editor.lineNumbers": "on",

    // WHAT: The condensed code overview beside the scrollbar.
    // WHY : Zed shows it only for files taller than the window. VS Code has no
    //       size-based rule, so the nearest equivalent is on but hidden until
    //       you scroll. The default is on and always visible.
    "editor.minimap.enabled": true,
    "editor.minimap.autohide": "scroll",

    // WHAT: Vertical guides at the given character columns.
    // WHY : The same three columns Neovim's `colorcolumn` and Zed's
    //       `wrap_guides` draw; see ../../../../README.md § Column guides.
    //       Nothing here wraps or reformats at them. The default is none.
    // NOTE: The object form is the newer schema and works in both editors; the
    //       bare-number form `[80, 120, …]` also works and is the older
    //       spelling. Each object
    //       also accepts a `color`, which is not used: Neovim and Zed paint
    //       every guide with one colour, so a coloured ruler here would make
    //       the editors disagree. The default colour is the theme's
    //       `editorRuler.foreground`.
    // HOW : Add or remove entries. An empty list turns the guides off. A
    //       per-language override looks like
    //       `"[markdown]": { "editor.rulers": [{ "column": 80 }] }`; the guides
    //       here are the same for every file type.
    "editor.rulers": [
        {
            "column": 80
        },
        {
            "column": 120
        },
        {
            "column": 150
        }
    ],

    // WHAT: Inline type and parameter-name annotations from the language server.
    // WHY : On (the default), matching Zed. Neovim keeps them behind a
    //       <leader>ti toggle because its display is denser.
    // NOTE: A string, not a boolean: "on", "off", "onUnlessPressed",
    //       "offUnlessPressed". A bare `true` is invalid. There is no global
    //       per-category control; Zed's show_type_hints and
    //       show_parameter_hints have no equivalent because each language
    //       extension owns its hint settings (rust-analyzer.inlayHints.*,
    //       python.analysis.inlayHints.*).
    "editor.inlayHints.enabled": "on",

    // --- Layout -------------------------------------------------------------
    // WHAT: Which side the primary side bar sits on.
    // WHY : Left, the default, matching where Zed docks its project, outline,
    //       git, and collaboration panels; VS Code hosts all of those as views
    //       in one side bar. Zed's `agent: { dock: "right" }` needs no
    //       equivalent, because chat lives in the secondary side bar, which is
    //       on the right.
    "workbench.sideBar.location": "left",

    // WHAT: The redesigned workbench: side bars and the bottom panel become
    //       floating cards with rounded corners and gaps, with refreshed
    //       workbench styles.
    // WHY : It shipped as a preview in VS Code 1.129 and is on by default in
    //       Insiders. The floating cards separate surfaces with padding, as
    //       Zed and Ghostty do. The value is written explicitly because the
    //       key's schema carries `experiment: { mode: "auto" }`, so VS Code may
    //       switch it on or off remotely for a share of users; a value here
    //       pins it.
    // HOW : Set false for the classic workbench. The companion key
    //       `workbench.experimental.modernUIUppercaseViewHeaders` (default
    //       false) puts view headers, side bar titles, and panel tabs in
    //       uppercase, and applies only while this is true.
    // NOTE: VS Code only. Cursor forked before 1.129 and does not register the
    //       key. Being experimental, it may be renamed or graduate to a stable
    //       id; if the UI stops changing, check whether the key still exists.
    // default: false
    "workbench.experimental.modernUI": true,

    // --- Terminal -----------------------------------------------------------
    // WHAT: The integrated terminal's font stack.
    // WHY : The Nerd Font Mono build, because Neovim runs in here and draws
    //       icon glyphs. FiraCode's Nerd build is the first fallback, so icons
    //       survive one step; plain JetBrains Mono follows it. See
    //       ../../../../README.md § The font stack.
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', 'FiraCode Nerd Font Mono', 'JetBrains Mono', 'Fira Code', 'Source Code Pro', 'IBM Plex Mono', monospace",
    "terminal.integrated.fontSize": 14,

    // WHAT: Ligatures in the terminal.
    // WHY : On, matching `editor.fontLigatures` above and every other surface
    //       in the repo; see ../../../../README.md § The font stack. This is a
    //       separate key, so the two can disagree, and it is off by default.
    // NOTE: The key takes a boolean, not the CSS feature string
    //       `editor.fontLigatures` accepts, so `true` means the font's default
    //       feature set rather than the named `calt` and `liga`. For
    //       JetBrains Mono those are the same two features.
    // default: false
    "terminal.integrated.fontLigatures.enabled": true,

    // WHAT: The integrated terminal's cursor: shape, blink, and its look when
    //       the terminal panel does not have keyboard focus.
    // WHY : A blinking block, matching `editor.cursorStyle` above and the rest
    //       of the stack. These keys do not inherit from the editor's, so the
    //       values are repeated. The shape is the default; the blink is not,
    //       and without it the terminal cursor sits still while the editor's
    //       blinks.
    // NOTE: `cursorStyleInactive` stays "outline": a hollow block, and the
    //       only cue for which pane has focus; "block" would make focused and
    //       unfocused terminals indistinguishable. Neovide draws its unfocused
    //       cursor the same way.
    // HOW : Shapes are "block", "line", "underline"; `cursorStyleInactive`
    //       also accepts "outline" and "none". `cursorBlinking` here is a
    //       boolean, unlike `editor.cursorBlinking`.
    // default: "block" / false / "outline"
    "terminal.integrated.cursorStyle": "block",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyleInactive": "outline",

    // WHAT: Which profile the integrated terminal launches, by name.
    // WHY : The fish shell, matching the login shell the installer offers to
    //       set. Both keys are needed: VS Code takes the default profile per
    //       platform and has no shared key.
    // NOTE: $TERM_PROGRAM is "vscode" in both editors, so a shell test for one
    //       applies to the other (see fish/conf.d/30-prompt.fish).
    "terminal.integrated.defaultProfile.osx": "fish",
    "terminal.integrated.defaultProfile.linux": "fish",

    // WHAT: The `fish` profile the two keys above name, defined here rather
    //       than detected, with the shell given as an absolute path.
    // WHY : Left undefined, VS Code supplies a `fish` profile from whatever it
    //       discovers, which on macOS means reading /etc/shells. That makes
    //       the terminal depend on a file this repo does not own: a fish that
    //       is installed but not listed there yields no profile, and the
    //       default silently falls back to the system shell. Naming the paths
    //       removes the discovery step.
    // NOTE: `path` takes "a single path to a shell executable or an array of
    //       paths that will be used as fallbacks when one fails", so one entry
    //       per prefix covers both machines a platform can be: Homebrew on
    //       Apple Silicon then Intel on macOS, Homebrew then a distribution
    //       package on Linux. Ghostty's `command` cannot express this and
    //       needs one path per per-OS file instead.
    //       No `args` are set. fish reads its own config whether or not it is
    //       a login shell, and VS Code hands the terminal its own environment
    //       rather than one built by /etc/profile.
    "terminal.integrated.profiles.osx": {
        "fish": {
            "path": [
                "/opt/homebrew/bin/fish",
                "/usr/local/bin/fish"
            ]
        }
    },
    "terminal.integrated.profiles.linux": {
        "fish": {
            "path": [
                "/home/linuxbrew/.linuxbrew/bin/fish",
                "/usr/bin/fish"
            ]
        }
    },

    // WHAT: Which application "Open in External Terminal" launches.
    // WHY : Ghostty, the terminal this setup runs. The default is Terminal.app.
    "terminal.external.osxExec": "Ghostty.app",

    // --- Privacy ------------------------------------------------------------
    // WHAT: Telemetry, off.
    // WHY : Matches Zed, where metrics and diagnostics are both off. "off"
    //       disables crash reports and usage data and opts out of A/B feature
    //       experiments, which need "all", the default.
    // HOW : Levels are "all", "error", "crash", "off". Browse everything that
    //       talks to a network with @tag:usesOnlineServices in the Settings UI.
    "telemetry.telemetryLevel": "off",

    // WHAT: Red Hat's extensions (YAML, XML) ship their own telemetry flag,
    //       which `telemetry.telemetryLevel` does not govern.
    // WHY : Off, for the same reason.
    "redhat.telemetry.enabled": false,

    // WHAT: Copilot session sync, described by VS Code as "Enable session sync
    //       to GitHub.com. When enabled, Copilot session data is synced to your
    //       GitHub account for cross-device access and richer insights."
    // WHY : Off. It sends chat session data off this machine, which the two
    //       settings above exist to prevent. Written explicitly for the reason
    //       given on `workbench.experimental.modernUI` above: the key's schema
    //       carries `experiment: { mode: "auto" }`.
    // HOW : Set true to share Copilot history across devices; it also needs
    //       `github.copilot.chat.localIndex.enabled`.
    // default: false
    "chat.sessionSync.enabled": false,

    // --- Updates ------------------------------------------------------------
    // WHAT: How the editor updates itself.
    // WHY : "default" checks for updates automatically. Both editors are also
    //       Homebrew casks (root Brewfile), so `brew upgrade` updates them
    //       too; set "none" to let brew own updates.
    "update.mode": "default",

    // WHAT: Whether extensions update themselves.
    // WHY : On (the default), which updates enabled extensions. Extensions are
    //       the part most often broken by an editor update, and install.sh
    //       installs only missing extensions, so this setting is what updates
    //       them.
    // NOTE: VS Code's values are "on" and "off"; it migrated the key from a
    //       boolean and rewrites the old form on startup. Cursor still takes
    //       true, "onlyEnabledExtensions", and false, so it flags "on" as
    //       unknown.
    // HOW : "off" (VS Code) or false (Cursor) pins everything, to update by
    //       hand.
    // default: "on"
    "extensions.autoUpdate": "on",

    // --- Explorer and git ---------------------------------------------------
    // WHAT: Skip the confirmation dialogs when deleting or moving a file.
    // WHY : Both default to true. Undo restores a deleted file.
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,

    // WHAT: Never scan parent directories for a git repository.
    // WHY : Stops the editor adopting an unrelated outer repository when a
    //       subdirectory is opened. The default, "prompt", asks.
    "git.openRepositoryInParentFolders": "never",

    // --- Icon theme ---------------------------------------------------------
    // WHAT: File icons, the glyphs beside filenames in the explorer and tabs.
    // WHY : The Catppuccin set, so the icons share the palette with the colour
    //       theme.
    // NOTE: Expect this value to change on its own, and do not correct it. Each
    //       flavour is a separate id with no light/dark pair, so this key names
    //       one. When both the colour theme and the icon theme are Catppuccin,
    //       the colour theme extension rewrites this key to the matching
    //       flavour and saves it, so the committed value is a seed and the
    //       deployed value is whichever appearance was last active. This is
    //       why the line appears in `git status` by itself.
    // HOW : Ships in `Catppuccin.catppuccin-vsc-icons`, declared in
    //       extensions.txt. Run "Preferences: File Icon Theme" to switch.
    //       `catppuccin.syncWithIconPack: false` stops the rewriting.
    "workbench.iconTheme": "catppuccin-latte",

    // WHAT: Product icons: the toolbar, activity-bar, and status-bar glyphs.
    // WHY : Catppuccin provides no product icon theme. Fluent's weight suits
    //       the Catppuccin file icons.
    // HOW : Ships in `miguelsolorio.fluent-icons`, declared in extensions.txt.
    //       Set "Default" for the built-in Codicons.
    "workbench.productIconTheme": "fluent-icons",

    // --- Copilot ------------------------------------------------------------
    // WHAT: Which languages Copilot may complete in.
    // WHY : Markdown only. VS Code-specific; Cursor ignores it and uses its own
    //       completion.
    "github.copilot.enable": {
        "markdown": true
    },

    // --- Cursor-specific ----------------------------------------------------
    // These keys have no effect in VS Code (see EACH EDITOR IGNORES THE OTHER'S
    // KEYS in the header).
    //
    // WHAT: Paths Cursor must never read into AI context.
    // WHY : Without it, credentials, private keys, and MCP configuration can be
    //       sent to a model as ordinary file context. Version-controlled as a
    //       security control.
    // HOW : Glob patterns, matched against the whole path. Add to this list
    //       rather than narrowing it.
    "cursor.general.globalCursorIgnoreList": [
        "**/credentials.json",
        "**/credentials.*.json",
        "**/secret.json",
        "**/secrets.json",
        "**/*.key",
        "**/*.pem",
        "**/*.pfx",
        "**/*.p12",
        "**/*.crt",
        "**/*.cer",
        "**/id_rsa",
        "**/id_dsa",
        "**/.ssh/id_*",
        "**/.cursor/mcp.json"
    ],

    // WHAT: Play a sound when a long agent run finishes.
    // WHY : A run can take minutes, and the sound means the window need not be
    //       watched.
    "cursor.composer.shouldChimeAfterChatFinishes": true,

    // --- Objective-C --------------------------------------------------------
    // NOTE: No `files.associations` entry. Zed maps .m and .mm to C++ because
    //       it has no Objective-C support; VS Code ships `objective-c` and
    //       `objective-cpp` languages with their own grammars, so the mapping
    //       is not needed here.

    // --- Modal editing ------------------------------------------------------
    // NOTE: No vim mode, as in Zed. VS Code has no built-in modal editing, so
    //       the choice is expressed by not listing `vscodevim.vim` in the
    //       extension lists.

    // WHAT: How a file from outside the trusted workspace is handled when
    //       opened into it.
    // WHY : "open" admits it without a prompt. The default, "prompt", asks once
    //       per workspace; "newWindow" opens it in a restricted window.
    "security.workspace.trust.untrustedFiles": "open",

    // WHAT: The Python interpreter the extension uses in a workspace where none
    //       has been selected yet.
    // WHY : The system interpreter, so loose scripts run without a venv. A
    //       selected interpreter overrides it. The default is "python".
    "python.defaultInterpreterPath": "/usr/bin/python3",

    // WHAT: Per-language override: the formatter for Markdown files.
    // WHY : The Markdown All in One extension (extensions.txt) is the only
    //       Markdown formatter installed. Naming it means a second one, if
    //       installed later, does not trigger VS Code's choose-a-formatter
    //       prompt.
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },

    // --- Lua ----------------------------------------------------------------
    // WHAT: Per-language override: the formatter for Lua files.
    // WHY : The Lua extension (extensions.txt) embeds lua-language-server,
    //       which is the only Lua formatter installed. Naming it means a
    //       second one, if installed later, does not trigger VS Code's
    //       choose-a-formatter prompt. Same reasoning as `[markdown]` above.
    // NOTE: `Lua.format.defaultConfig` is deliberately not set, so the
    //       formatter keeps its own defaults. Its schema declares
    //       `additionalProperties: false` with no properties, so any key
    //       inside it is flagged by the JSONC schema, and formatting here is
    //       manual anyway (see "On save" above).
    "[lua]": {
        "editor.defaultFormatter": "sumneko.lua"
    },

    // WHAT: Which Lua the server type-checks against.
    // WHY : Neovim embeds LuaJIT, which is 5.1 plus extensions. The default is
    //       "Lua 5.4", under which `unpack`, `loadstring`, and the `bit`
    //       library are reported as undefined and 5.4-only syntax is accepted
    //       that Neovim would reject.
    // HOW : Values: Lua 5.1 to 5.5, and LuaJIT.
    "Lua.runtime.version": "LuaJIT",

    // WHAT: Names the server treats as defined globals.
    // WHY : The default is empty, so every `vim.*` call in nvim/ is reported
    //       as an undefined global. `vim` is injected by Neovim rather than
    //       declared in any file the server can see.
    "Lua.diagnostics.globals": [
        "vim"
    ],

    // WHAT: Directories whose Lua the server reads for definitions without
    //       treating them as workspace files to lint.
    // WHY : Neovim's own runtime, which is what makes `vim.api` and `vim.fn`
    //       complete with signatures rather than resolving to nothing. The
    //       default is empty.
    // NOTE: Four paths for one machine each, because this file is shared by
    //       both editors and both platforms and JSONC has no conditionals:
    //       Homebrew on Apple Silicon, Homebrew on Intel, Homebrew on Linux,
    //       and a distribution package. The server skips a path that does not
    //       exist, so listing all four costs nothing, which is the same
    //       approach fish takes when it probes the Homebrew prefixes.
    // HOW : `Lua.runtime.path` would additionally need "lua/?.lua" to resolve
    //       this repo's own `require` calls between files under
    //       nvim/.config/nvim/lua/; it is left at its default.
    "Lua.workspace.library": [
        "/opt/homebrew/share/nvim/runtime",
        "/usr/local/share/nvim/runtime",
        "/home/linuxbrew/.linuxbrew/share/nvim/runtime",
        "/usr/share/nvim/runtime"
    ],

    // --- YAML ---------------------------------------------------------------
    // WHAT: Glob patterns whose YAML files Red Hat's YAML extension will not
    //       try to match against a schema.
    // WHY : Workflow files belong to `github.vscode-github-actions`
    //       (extensions.txt), which brings its own schema and completion for
    //       them. Left to detect, `redhat.vscode-yaml` also matches them
    //       against the GitHub Actions schema it pulls from schemastore.org,
    //       so a key one schema knows and the other does not is reported as an
    //       error. Gitea and Forgejo use the same workflow format on paths the
    //       Actions extension does not claim, so they are listed too.
    // NOTE: The extension adds the `.github/workflows` patterns by itself when
    //       the Actions extension is enabled. They are listed anyway because
    //       the documentation does not say whether an explicit value extends
    //       that list or replaces it.
    // HOW : Either a single glob string or a list of them. Modelines
    //       (`# yaml-language-server: $schema=…`) still apply to a file
    //       matched here.
    // default: []
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ]
}
